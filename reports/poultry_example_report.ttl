@prefix LHO: <http://www.purl.org/decide/LiveStockHealthOnto/LHO#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode LHO:ExamplePoultrySample_4 ;
            sh:resultMessage "Poultry sample needs exactly one production stage (for example Broiler)." ;
            sh:resultPath LHO:hasProductionStages ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Poultry sample needs exactly one production stage (for example Broiler)." ;
                    sh:minCount 1 ;
                    sh:path LHO:hasProductionStages ] ],
        [ a sh:ValidationResult ;
            sh:focusNode LHO:ExamplePoultrySample_3 ;
            sh:resultMessage "Pathogen must be one of the IBV genotypes in the Poultry Barometer catalogue, or 'other'." ;
            sh:resultPath LHO:hasPathogen ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( LHO:QX LHO:793B LHO:Mass LHO:D274 LHO:D2860 LHO:D181 LHO:D1466 LHO:CR88 LHO:Xindadi LHO:other ) ;
                    sh:maxCount 1 ;
                    sh:message "Pathogen must be one of the IBV genotypes in the Poultry Barometer catalogue, or 'other'." ;
                    sh:minCount 1 ;
                    sh:path LHO:hasPathogen ] ;
            sh:value LHO:491 ],
        [ a sh:ValidationResult ;
            sh:focusNode LHO:ExamplePoultrySample_4 ;
            sh:resultMessage "One date is required, written as an ISO date (YYYY-MM-DD) or a quarter (YYYY-Qn), as used in the Poultry Barometer." ;
            sh:resultPath LHO:hasDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:PatternConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "One date is required, written as an ISO date (YYYY-MM-DD) or a quarter (YYYY-Qn), as used in the Poultry Barometer." ;
                    sh:minCount 1 ;
                    sh:path LHO:hasDate ;
                    sh:pattern "#[0-9]{4}-(Q[1-4]|[0-9]{2}-[0-9]{2})$" ] ;
            sh:value LHO:2021-summer ] .

