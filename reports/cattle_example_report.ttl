    rdf:rest ( LHO:1 ) .

_:n5f9432f66913492e87dc753ebd8fda99b11 sh:in _:N770d2029c18f498dbf345bf6a30bdcf5 ;
    sh:maxCount 1 ;
    sh:message "Result must be given once, as LHO:0 (negative) or LHO:1 (positive)." ;
    sh:minCount 1 ;
    sh:path LHO:hasResult .

